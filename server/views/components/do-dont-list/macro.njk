{% macro doDontList(params) %}
  {% set title = params.title %}
  {% set type = params.type %}
  {% set items = params.items %}

  <div class="do-dont__wrap govuk-!-margin-bottom-8">
    <div class="do-dont__content">
      <h3 class="do-dont__heading">
        {{ title }}
      </h3>

      <ul class="do-dont__list" role="list">
        {% for item in items %}
          <li>
            {% if type == "tick" %}
              <svg class="tick" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" focusable="false" aria-hidden="true">
                <path d="M11.4 17.5a2 2 0 0 1-2.7.1h-.1L4 12.8a1.5 1.5 0 0 1 2.1-2L10 14.7l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"></path>
              </svg>
            {% else %}
              <svg class="cross" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" focusable="false" aria-hidden="true">
                <path d="M17 18.5c-.4 0-.8-.1-1.1-.4l-10-10c-.6-.6-.6-1.6 0-2.1.6-.6 1.5-.6 2.1 0l10 10c.6.6.6 1.5 0 2.1-.3.3-.6.4-1 .4z M7 18.5c-.4 0-.8-.1-1.1-.4-.6-.6-.6-1.5 0-2.1l10-10c.6-.6 1.5-.6 2.1 0 .6.6.6 1.5 0 2.1l-10 10c-.3.3-.6.4-1 .4z"></path>
              </svg>
            {% endif %}
            {{ item }}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
{% endmacro %}