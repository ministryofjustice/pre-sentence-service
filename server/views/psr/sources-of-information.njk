{% extends "../partials/psrPageLayout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% set currentPage = 'Sources of information' %}
{% set pageTitle = preSentenceType + " - " + currentPage %}

{% block reportForm %}
  <div class="govuk-!-margin-bottom-7">
    <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">{{ currentPage }}</h1>
    {% include "../partials/autosaveStatus.njk" %}
  </div>

  <form
    method="post"
    action="/{{ reportPath }}/{{ reportId }}/sources-of-information"
    data-autosave="true"
    novalidate
  >
    <section class="section-wrapper"> 
      <div class="govuk-form-group govuk-!-margin-bottom-0 {% if 'sourcesOfInformation' in elementsWithError %}govuk-form-group--error{% endif %}">
        <fieldset class="govuk-fieldset"
          aria-describedby="sourcesOfInformation-hint {% if 'sourcesOfInformation' in elementsWithError %}sourcesOfInformation-error{% endif %}">
          <legend class="govuk-visually-hidden">Sources of information</legend>


          <div id="sourcesOfInformation-hint" class="govuk-hint soi-hint">
            Select all sources used to inform this report.
          </div>

          {% if 'sourcesOfInformation' in elementsWithError %}
            <p id="sourcesOfInformation-error" class="govuk-error-message">
              <span class="govuk-visually-hidden">Error:</span>
              You must select one or more sources used to inform this report
            </p>
          {% endif %}

          <div class="govuk-checkboxes" data-module="govuk-checkboxes">
            {% for source in sourcesOfInformation %}
              <div class="govuk-checkboxes__item">
                <input class="govuk-checkboxes__input"
                      id="{{ source.key }}"
                      name="sourcesOfInformation"
                      type="checkbox"
                      value="{{ source.key }}"
                      {% if source.checked %}checked{% endif %}>
                <label class="govuk-label govuk-checkboxes__label" for="{{ source.key }}">
                  {{ source.value }}
                </label>
              </div>
            {% endfor %}
          </div>
        </fieldset>
      </div>
    </section>
      
    {% if addedSourcesOfInformation | length %}
      <div id="added-sources" class="added-source-wrapper">
        <h2 class="govuk-heading-m govuk-!-margin-bottom-3">Added sources</h2>

        {% for source in addedSourcesOfInformation %}
          <div class="added-source">
            <span class="govuk-body govuk-!-margin-bottom-0">{{ source.value }}</span>

            <button
              type="submit"
              name="removeSource"
              value="{{ source.key }}"
              class="govuk-link govuk-link--no-visited-state govuk-!-margin-left-5 remove-link-button"
            >
            Remove <span class="govuk-visually-hidden">{{ source.value }}</span>
            </button>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <section class="govuk-form-group govuk-!-margin-bottom-7 {% if 'source' in elementsWithError %} govuk-form-group--error{% endif %}">
      <div class="govuk-label-wrapper">
        <label class="govuk-label govuk-label--m govuk-!-margin-bottom-3" for="source">
          Add another source of information
        </label>
      </div>

      {% if 'source' in elementsWithError %}
        <p id="source-error" class="govuk-error-message">
          <span class="govuk-visually-hidden">Error:</span>
          {{ formValidation.errors.source }}
        </p>
      {% endif %}

      <input
        class="govuk-input govuk-!-width-two-thirds{% if 'source' in elementsWithError %} govuk-input--error{% endif %}"
        id="source"
        name="source"
        type="text"
        value="{{ data.source or '' }}"
        data-max-length="80"
        data-character-count-errors-only
        aria-describedby="{% if 'source' in elementsWithError %}source-error {% endif %}source-info"
      >

      <button
        type="submit"
        name="action"
        value="add-source"
        class="govuk-button govuk-button--secondary add-source-btn"
        data-module="govuk-button"
        data-prevent-double-click="true"
      >
        Add to list
      </button>


      <div
        class="govuk-!-margin-top-2"
        data-character-count-for="source"
        id="source-info"
        aria-live="polite"
        hidden
      ></div>
    </section>

    <input type="hidden" name="CSRFToken" value="{{ csrfToken }}">
    <input type="hidden" name="reportId" value="{{ reportId }}">
    <input type="hidden" name="pageName" value="{{ pageName }}">

    {{ govukButton({
      text: "Save and continue",
      attributes: { name: "action", value: "save-list" }
    }) }}
  </form>
{% endblock %}

{% block additionalScripts %}
  {{ super() }}
  <script src="/assets/sources-of-information.js"></script>
{% endblock %}