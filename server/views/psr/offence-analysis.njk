{% extends "../partials/psrPageLayout.njk" %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "components/text-editor/macro.njk" import picTextEditor %}


{% set currentPage = 'Offence analysis' %}
{% set pageTitle = preSentenceType + " - " + currentPage %}

{% block reportForm %}

<form method="post" data-autosave="true" novalidate>
  <div class="govuk-!-margin-bottom-7">
    <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">{{ currentPage }}</h1>
    {% include "../partials/autosaveStatus.njk" %}
  </div>

  <section class="section-wrapper">
    <h2 class="govuk-heading-l govuk-!-margin-bottom-6">Review offences</h2>
    <p class="govuk-body">You can edit offences in this PSR but your changes will not be shown in NDelius.
    Any further changes to offences in NDelius will not be shown in this report.</p>

    {% if data.offencesAvailable %}
      {% set additionalOffencesHtml %}
        {% if data.offences.additionalOffences | length %}
          {% for offence in data.offences.additionalOffences %}
            <p class="govuk-body govuk-!-margin-bottom-1">{{ offence }}</p>
          {% endfor %}
        {% else %}
          No additional offences
        {% endif %}
      {% endset %}

      {{ govukSummaryList({
        card: {
          title: { text: "Offence details" },
          actions: {
            items: [
              {
                href: "/" + reportPath + "/" + reportId + "/edit-offences",
                text: "Edit offences",
                visuallyHiddenText: "offence details"
              }
            ]
          }
        },
        rows: [
          { key: { text: "Main offence" }, value: { text: data.offences.mainOffence } },
          { key: { text: "Additional offences" }, value: { html: additionalOffencesHtml } }
        ]
      }) }}
    {% else %}
      <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
          <span class="govuk-visually-hidden">Warning</span>
          Unable to fetch offence details from NDelius. Please refresh the page or check NDelius directly.
        </strong>
      </div>
    {% endif %}
  </section>

  <section class="section-wrapper">
    <h2 class="govuk-heading-l govuk-!-margin-bottom-6" id="offences-under-consideration">Analyse offences under consideration</h2>

    {{ picTextEditor({
      label: {
        text: "Analyse offences under consideration",
        classes: "govuk-visually-hidden"
      },
      name: "offencesUnderConsideration",
      id: "offencesUnderConsideration",
      value: data.offencesUnderConsideration,
      rows: "10",
      longText: true,
      hint: {
        text: "State how the defendant pleaded and where relevant, whether the court has accepted a basis of plea. Explain the key circumstances and motivations linked to the offences, taking into account the defendant’s lived experience and understanding of victim considerations. Include evidence of offences becoming more serious or frequent, planning and premeditation, or behaviours similar to previous offending. "
      },
      errorMessage: {
        text: formValidation.errors.offencesUnderConsideration
      } if 'offencesUnderConsideration' in elementsWithError
    }) }}
  </section>

  <section class="section-wrapper">
    <h2 class="govuk-heading-l govuk-!-margin-bottom-6" id="previous-offending-behaviour">Analyse previous offending behaviour and response to supervision</h2>

    {{ picTextEditor({
      label: {
        text: "Analyse previous offending behaviour and response to supervision",
        classes: "govuk-visually-hidden"
      },
      name: "offencesPattern",
      id: "offencesPattern",
      value: data.offencesPattern,
      rows: "10",
      longText: true,
      hint: {
        text: "Identify patterns in previous offending, factors linked to this behaviour and protective factors which could explain gaps in offending. Highlight any previous responses to supervision, considering levels of compliance and reasons for this, such as relevant lived experience."
      },
      errorMessage: {
        text: formValidation.errors.offencesPattern
      } if 'offencesPattern' in elementsWithError
    }) }}
  </section>
  
    <input type="hidden" name="CSRFToken" value="{{ csrfToken }}">
    <input type="hidden" name="reportId" value="{{ reportId }}">
    <input type="hidden" name="pageName" value="{{ pageName }}">
    <button class="govuk-button">Save and continue</button>
  </form>

{% endblock %}
