{% extends "../partials/psrPageLayout.njk" %}

{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% set currentPage = "Sign your report" if featureUnlockedSigning else "Sign and lock your report" %}
{% set pageTitle = preSentenceType + " - " + currentPage %}
{% set reviewProgressErrorText = "before signing this report" if featureUnlockedSigning else "before signing and locking this report" %}
{% set submitButtonText = "Sign and complete" if featureUnlockedSigning else "Submit" %}
{% block reportForm %}
    <form method="post"
          data-autosave="true"
          data-confirm-submit="true"
          novalidate>

        <div class="govuk-!-margin-bottom-7">
            <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">{{ currentPage }}</h1>
            {% include "../partials/autosaveStatus.njk" %}
        </div>

        <section class="section-wrapper">
            {% if data.reviewProgressBlocked %}
                <p class="govuk-error-message" id="reviewProgress">
                    <span class="govuk-visually-hidden">Error:</span>
                    Complete all sections in <a class="govuk-link" href="/{{ reportPath }}/{{ reportId }}/preview-report">Review your progress</a> {{ reviewProgressErrorText }}.
                </p>
            {% endif %}

            {% if featureUnlockedSigning %}
                {% if data.previouslySigned %}
                    {{ govukWarningText({
                        "text": "A previous version of this report has been signed and made available on NDelius. Signing your report will replace that version on NDelius.",
                        "iconFallbackText": "Warning"
                    }) }}
                {% else %}
                    {{ govukInsetText({
                        "text": "After you sign your report it will be available on NDelius. You'll be able to reopen, edit and resign the report until it is locked in NDelius."
                    }) }}
                {% endif %}
            {% else %}
                {{ govukWarningText({
                    "text": "Submitting your report will lock the PSR and you will no longer be able to make any further edits.",
                    "iconFallbackText": "Warning"
                }) }}
            {% endif %}

            {{ govukInput({
                hint: {
                text: "Enter your full name",
                classes: "govuk-hint govuk-!-margin-bottom-2"
                },
                name: "signReportName",
                type: "text",
                id: "signReportName",
                rows: "1",
                value: data.signReportName,
                errorMessage: {
                text: formValidation.errors.signReportName
                } if 'signReportName' in elementsWithError
            }) }}
        </section>

        <section class="section-wrapper">
            {{ govukRadios({
                idPrefix: "professionalStatus",
                name: "professionalStatus",
                fieldset: {
                    legend: {
                        text: "What is your professional status?",
                        classes: "govuk-fieldset__legend--m"
                    }
                },
                 hint: {
                            html: "This could be different from your job title. If you are a trainee <br/>
                                   probation officer on the PQiP programme you should select your current professional <br/>
                                   status.",
                                   classes: "govuk-!-margin-bottom-6"
                          },
                errorMessage: {
                    text: formValidation.errors.professionalStatus,
                    classes: "govuk-!-margin-bottom-6"
                } if 'professionalStatus' in elementsWithError,
                items: [
                    {
                        value: "registered probation officer",
                        text: "Registered Probation Officer",
                        checked: data.professionalStatus == "registered probation officer"
                    },

                    {
                    value: "registered probation service officer",
                    text: "Registered Probation Service Officer",
                    checked: data.professionalStatus == "registered probation service officer"
                    },
                 {
                    value: "probation service officer",
                    text: "Probation Service Officer",
                    checked: data.professionalStatus == "probation service officer"
                }
                ]
            }) }}
        </section>

        <input type="hidden" name="CSRFToken" value="{{ csrfToken }}">
        <input type="hidden" name="reportId" value="{{ reportId }}">
        <input type="hidden" name="pageName" value="{{ pageName }}">
        <button class="govuk-button">{{ submitButtonText }}</button>
    </form>

    {% if featureUnlockedSigning %}
        <div class="govuk-modal" id="confirm-modal" hidden>
            <div class="govuk-modal__overlay"></div>
            <div class="govuk-modal__content govuk-width-container"
                tabindex="-1"
                role="dialog"
                aria-modal="true"
                aria-labelledby="confirm-title"
                aria-describedby="confirm-message">
                <button type="button" id="close-modal" class="govuk-modal__close button-as-link" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h2 id="confirm-title" class="govuk-heading-m">Are you ready to sign your report?</h2>
                <p id="confirm-message" class="govuk-body">Your report will be available on NDelius. You can reopen and edit it until it is locked in NDelius.</p>
                <div class="govuk-button-group">
                    <button
                        id="confirm-submit"
                        type="button"
                        class="govuk-button govuk-!-margin-bottom-0 govuk-!-margin-right-6"
                    >
                        Sign
                    </button>

                    <button type="button" id="cancel-submit" class="govuk-link button-as-link">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    {% else %}
        <div class="govuk-modal" id="confirm-modal" hidden>
            <div class="govuk-modal__overlay"></div>
            <div class="govuk-modal__content govuk-width-container"
                tabindex="-1"
                role="dialog"
                aria-modal="true"
                aria-labelledby="confirm-title"
                aria-describedby="confirm-message">
                <h2 id="confirm-title" class="govuk-heading-m">Are you ready to sign and lock your report?</h2>
                <p id="confirm-message" class="govuk-body">You will not be able to edit your report after submitting.</p>
                <div class="govuk-button-group">
                    <button
                        id="confirm-submit"
                        type="button"
                        class="govuk-button govuk-!-margin-bottom-0 govuk-!-margin-right-6"
                    >
                        Sign and lock
                    </button>

                    <button type="button" id="cancel-submit" class="govuk-link button-as-link">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
